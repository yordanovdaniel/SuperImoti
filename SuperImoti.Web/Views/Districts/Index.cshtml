@model List<DistrictRowViewModel>
@{
    ViewData["Title"] = "Квартали";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Квартали</h1>
        <div class="small text-body-secondary">Брой активни обяви и средни цени на апартаментите по квартали.</div>
    </div>
    <div class="d-flex gap-2">
        <input type="search" class="form-control js-table-filter" data-target="#district-table" placeholder="Търси квартал" aria-label="Търсене на квартал" />
        @if (User.IsAdmin())
        {
            <a class="btn btn-primary text-nowrap" asp-action="Create"><i class="bi bi-plus-lg"></i> Нов квартал</a>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="district-table">
            <thead class="table-light">
                <tr>
                    <th scope="col">Квартал</th>
                    <th scope="col" class="text-end">Продажби</th>
                    <th scope="col" class="text-end">Наеми</th>
                    <th scope="col" class="text-end">Средна цена/м² (апартаменти)</th>
                    <th scope="col" class="text-end">Среден наем (апартаменти)</th>
                    @if (User.IsAdmin())
                    {
                        <th scope="col" class="text-end">Управление</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var district in Model)
                {
                    <tr data-filter-text="@district.Name.ToLowerInvariant()">
                        <td>
                            <a asp-action="Details" asp-route-id="@district.Id">@district.Name</a>
                            @if (district.City != "София")
                            {
                                <span class="small text-body-secondary">(@district.City)</span>
                            }
                        </td>
                        <td class="text-end">@Fmt.Number(district.SaleCount)</td>
                        <td class="text-end">@Fmt.Number(district.RentCount)</td>
                        <td class="text-end">@(district.AvgApartmentSalePricePerSqm is null ? "—" : Fmt.Money(Math.Round(district.AvgApartmentSalePricePerSqm.Value)))</td>
                        <td class="text-end">@(district.AvgApartmentRent is null ? "—" : Fmt.Money(Math.Round(district.AvgApartmentRent.Value)))</td>
                        @if (User.IsAdmin())
                        {
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@district.Id" title="Редактирай"><i class="bi bi-pencil"></i></a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@district.Id" title="Изтрий"><i class="bi bi-trash"></i></a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
