@model DistrictDeleteViewModel
@{
    ViewData["Title"] = "Изтриване на квартал";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Изтриване на квартал</h1>
        <div class="card card-body shadow-sm">
            <p class="mb-2">Квартал: <strong>@Model.District.Name</strong> (@Model.District.City)</p>
            @if (Model.ListingCount > 0)
            {
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle"></i>
                    Кварталът има @Fmt.Number(Model.ListingCount) обяви и не може да бъде изтрит.
                    Първо преместете или изтрийте обявите.
                </div>
                <a asp-action="Details" asp-route-id="@Model.District.Id" class="btn btn-outline-secondary">Назад</a>
            }
            else
            {
                <p class="text-danger">Сигурни ли сте, че искате да изтриете този квартал?</p>
                <form asp-action="Delete" asp-route-id="@Model.District.Id" method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Да, изтрий</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                </form>
            }
        </div>
    </div>
</div>
