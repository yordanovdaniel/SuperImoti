@model DistrictFormModel
@{
    ViewData["Title"] = "Нов квартал";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Нов квартал</h1>
        <form asp-action="Create" method="post" class="card card-body shadow-sm">
            <partial name="_DistrictForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Добави</button>
                <a asp-action="Index" class="btn btn-link">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
