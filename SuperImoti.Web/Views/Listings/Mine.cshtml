@model PagedResult<ListingCardViewModel>
@{
    ViewData["Title"] = "Моите обяви";
    var grid = new ListingGridViewModel(Model.Items, 3, "Все още нямате публикувани обяви.");
    var pager = new PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        PageUrl = page => Url.Action("Mine", new { page })!,
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Моите обяви</h1>
        <div class="small text-body-secondary">@Fmt.Number(Model.TotalCount) публикувани обяви</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Нова обява</a>
</div>
<partial name="_ListingGrid" model="grid" />
<partial name="_Pagination" model="pager" />
