<div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
    <a class="btn btn-light btn-sm fw-semibold" asp-controller="Listings" asp-action="Create">
        <i class="bi bi-plus-lg"></i> Публикувай обява
    </a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="dropdown">
            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i> @User.GetDisplayName()
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Профил</a></li>
                <li><a class="dropdown-item" asp-controller="Listings" asp-action="Mine"><i class="bi bi-card-list me-2"></i>Моите обяви</a></li>
                <li><a class="dropdown-item" asp-controller="Favorites" asp-action="Index"><i class="bi bi-heart me-2"></i>Любими</a></li>
                @if (User.IsAdmin())
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Администрация</a></li>
                }
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Изход</button>
                    </form>
                </li>
            </ul>
        </div>
    }
    else
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Вход</a>
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Register">Регистрация</a>
        </div>
    }
</div>
