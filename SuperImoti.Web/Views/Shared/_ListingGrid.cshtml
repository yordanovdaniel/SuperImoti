@model ListingGridViewModel
@{
    var rowClass = $"row row-cols-1 row-cols-sm-2 row-cols-lg-{Model.Columns} g-3";
}
@if (Model.Items.Count == 0)
{
    <div class="empty-state text-center text-body-secondary py-5">
        <i class="bi bi-house-x display-5 d-block mb-2"></i>
        @(Model.EmptyText ?? "Няма намерени обяви.")
    </div>
}
else
{
    <div class="@rowClass">
        @foreach (var card in Model.Items)
        {
            <div class="col">
                <partial name="_ListingCard" model="card" />
            </div>
        }
    </div>
}
