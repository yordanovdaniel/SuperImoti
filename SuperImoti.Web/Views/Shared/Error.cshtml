@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}
<div class="error-page text-center py-5">
    <i class="bi bi-bug display-1 text-danger"></i>
    <h1 class="h3 mt-3">Възникна неочаквана грешка</h1>
    <p class="text-body-secondary">Нещо се обърка при обработката на заявката. Опитайте отново след малко.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary">Код на заявката: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Към началото</a>
</div>
