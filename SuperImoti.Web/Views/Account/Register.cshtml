@model RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">Регистрация</h1>
                <p class="text-body-secondary small">С профил можете да публикувате обяви, да коментирате и да запазвате любими.</p>
                <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label required"></label>
                        <input asp-for="DisplayName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label required"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label required"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label required"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12 form-text mt-1">Поне 6 символа, с поне една малка буква и една цифра.</div>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="NotifyAboutNewListings" class="form-check-input" />
                        <label asp-for="NotifyAboutNewListings" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-plus"></i> Създай профил</button>
                </form>
                <p class="small text-center mt-3 mb-0">
                    Вече имате профил? <a asp-action="Login" asp-route-returnUrl="@returnUrl">Влезте</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
