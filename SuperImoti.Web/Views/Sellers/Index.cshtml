@model SellerIndexViewModel
@{
    ViewData["Title"] = "Агенции";
    var results = Model.Results;
    var pager = new PaginationViewModel
    {
        Page = results.Page,
        TotalPages = results.TotalPages,
        PageUrl = page => Url.Action("Index", new { q = Model.Q, sort = Model.Sort == "name" ? "name" : null, page })!,
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Агенции за недвижими имоти</h1>
        <div class="small text-body-secondary">@Fmt.Number(results.TotalCount) агенции с обяви в imot.bg</div>
    </div>
    <form method="get" asp-action="Index" class="d-flex gap-2 js-clean-get" role="search">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Име на агенция" aria-label="Търсене на агенция" maxlength="100" />
        <select name="sort" class="form-select w-auto" aria-label="Подреждане">
            <option value="" selected="@(Model.Sort != "name")">Най-много обяви</option>
            <option value="name" selected="@(Model.Sort == "name")">По име</option>
        </select>
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i><span class="visually-hidden">Търси</span></button>
    </form>
</div>

@if (results.Items.Count == 0)
{
    <div class="empty-state text-center text-body-secondary py-5">
        <i class="bi bi-briefcase display-5 d-block mb-2"></i> Няма намерени агенции.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var seller in results.Items)
        {
            <div class="col">
                <a class="card h-100 shadow-sm text-decoration-none text-reset seller-card" asp-action="Details" asp-route-id="@seller.Id">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h2 class="h6 mb-1">@seller.Name</h2>
                            <span class="badge text-bg-primary">@Fmt.Number(seller.ActiveListings)</span>
                        </div>
                        @if (seller.MemberSince is not null)
                        {
                            <div class="small text-body-secondary">В imot.bg @seller.MemberSince</div>
                        }
                        @if (seller.OfficeAddress is not null)
                        {
                            <div class="small mt-2 text-truncate" title="@seller.OfficeAddress"><i class="bi bi-geo-alt"></i> @seller.OfficeAddress</div>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
}
<partial name="_Pagination" model="pager" />
